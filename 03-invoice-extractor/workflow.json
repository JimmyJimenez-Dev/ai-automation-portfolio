    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an accounts payable assistant. Extract the data from this invoice text.\n\nInvoice text:\n{{ $json.text }}\n\nReturn ONLY valid JSON, no extra text, with this exact structure:\n{\"vendor\": \"\", \"invoice_number\": \"\", \"invoice_date\": \"YYYY-MM-DD\", \"total\": 0.00, \"tax\": 0.00, \"currency\": \"USD\", \"line_items\": [{\"description\": \"\", \"quantity\": 0, \"unit_price\": 0.00, \"amount\": 0.00}]}\n\nIf a field is missing in the invoice, use null. Never invent data.",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        448,
        0
      ],
      "id": "977ca20c-79e1-4a2b-ad8d-8dd4214cef91",
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "claude-sonnet-5",
          "mode": "list",
          "cachedResultName": "Claude Sonnet 5"
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.6,
      "position": [
        384,
        208
      ],
      "id": "e11104d3-7e4a-4001-86f1-232c173e0953",
      "name": "Anthropic Chat Model",
      "credentials": {
        "anthropicApi": {
          "id": "zT3ehTX2FNom03v5",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "let data;\ntry {\n  const raw = $input.first().json.text.replace(/```json|```/g, '').trim();\n  data = JSON.parse(raw);\n} catch (e) {\n  return [{ json: { valid: false, issues: 'AI returned invalid JSON' } }];\n}\n\nconst issues = [];\n['vendor', 'invoice_number', 'invoice_date', 'total'].forEach(f => {\n  if (data[f] === null || data[f] === undefined || data[f] === '') issues.push('Missing ' + f);\n});\n\nconst items = Array.isArray(data.line_items) ? data.line_items : [];\nconst itemsSum = items.reduce((s, i) => s + Number(i.amount || 0), 0);\nconst expected = itemsSum + Number(data.tax || 0);\nif (items.length && Math.abs(expected - Number(data.total)) > 0.05) {\n  issues.push('Total mismatch: items + tax = ' + expected.toFixed(2) + ' vs total = ' + Number(data.total).toFixed(2));\n}\n\nreturn [{ json: {\n  valid: issues.length === 0,\n  issues: issues.join('; '),\n  vendor: data.vendor,\n  invoice_number: data.invoice_number,\n  invoice_date: data.invoice_date,\n  total: data.total,\n  tax: data.tax,\n  line_items: items.map(i => i.quantity + ' x ' + i.description + ' @ $' + i.unit_price).join(' \\n ')\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
